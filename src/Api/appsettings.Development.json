{
  // Development only. The signing key here is a placeholder for local work and must never appear in
  // any other environment — staging and production supply theirs through environment variables or a
  // secret store. See README.md.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ConnectionStrings": {
    "KaffDatabase": "Host=localhost;Port=5432;Database=kaff;Username=kaff;Password=kaff"
  },
  "Jwt": {
    "Issuer": "kaff-erp-dev",
    "Audience": "kaff-erp-web-dev",
    "SigningKey": "development-only-signing-key-not-for-any-real-environment",
    "ClockSkewSeconds": 60
  },
  "Kaff": {
    "ApplyMigrationsOnStartup": true,
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
